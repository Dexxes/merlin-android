<?xml version="1.0" encoding="utf-8"?>
<!-- Android-Sicherung und Geräteumzug ab Android 12 (android:dataExtractionRules). Zugangsdaten
     bleiben draußen, Begründung siehe backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="merlin_credentials.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="merlin_credentials.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
