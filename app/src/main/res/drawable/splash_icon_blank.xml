<!-- Leeres Icon für den System-Splash (Theme.Merlin.Starting). Die Android-12+-SplashScreen-API
     schneidet ihr Icon immer auf eine Kreismaske zu – das Merlin-Logo würde dort nie vollständig
     erscheinen. Deshalb zeigt der System-Splash nur die Hintergrundfarbe, und das Logo kommt
     unbeschnitten aus dem Compose-Splash (ui/screens/MerlinSplash.kt), genau wie iOS mit leerem
     `UILaunchScreen` und anschließendem `SplashView`. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h1v1h-1z" />
</vector>
