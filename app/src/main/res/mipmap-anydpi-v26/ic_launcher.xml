<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive Icon (API 26+) – Äquivalent zum iOS-AppIcon (AppIcon.appiconset).
     Vordergrund (Hund+Buch, Pixel-Art) als eigene transparente Ebene, damit
     launcherspezifische Masken (Kreis/Squircle/abgerundetes Quadrat/...) das
     Motiv nicht beschneiden – siehe `ic_launcher_foreground.png`-Generierung
     in todo.md/Structure.md (62%-Safe-Zone-Skalierung). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
